<Window x:Class="SubiektNexoConnector.Deployment.PostRebootResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SubiektNexoConnector · test po restarcie"
        Width="780" Height="650" MinWidth="650" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA"
        FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFD6E1"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#185ADB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#185ADB"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,18">
      <TextBlock Text="TEST PO PONOWNYM URUCHOMIENIU" Foreground="#53647B" FontWeight="SemiBold"/>
      <TextBlock x:Name="HeadingText" FontSize="28" FontWeight="SemiBold" Foreground="#172D4D" Margin="0,6,0,0"/>
    </StackPanel>

    <Border x:Name="StatusBorder" Grid.Row="1" CornerRadius="10" Padding="18" Margin="0,0,0,16">
      <StackPanel>
        <Border x:Name="StatusBadge" HorizontalAlignment="Left" CornerRadius="10" Padding="10,4" Margin="0,0,0,12"><TextBlock x:Name="StatusText" Foreground="White" FontSize="12" FontWeight="Bold"/></Border>
        <TextBlock x:Name="SummaryText" FontSize="16" FontWeight="SemiBold" Foreground="#172D4D"/>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock Text="Potwierdzono działanie" Foreground="#53647B"/><TextBlock x:Name="VerifiedAtText" FontWeight="SemiBold" Margin="0,4,12,0"/></StackPanel>
          <StackPanel Grid.Column="1"><TextBlock Text="Szacowany start Windows" Foreground="#53647B"/><TextBlock x:Name="WindowsStartedAtText" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#EDF3FF" CornerRadius="8" Padding="14" Margin="0,0,0,16">
      <StackPanel><TextBlock Text="CO DALEJ" Foreground="#185ADB" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="RecommendationText" Margin="0,6,0,0" Foreground="#243B5A"/></StackPanel>
    </Border>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="Szczegóły techniczne" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="DetailsBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#10233D" Foreground="#EAF2FF" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="12"/>
      <TextBlock x:Name="ReportPathText" Grid.Row="2" Foreground="#53647B" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>

    <DockPanel Grid.Row="4" Margin="0,18,0,0">
      <Button Content="Otwórz folder raportu" Click="OpenReportFolder_Click" DockPanel.Dock="Left" Margin="0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Kopiuj szczegóły" Click="CopyDetails_Click"/><Button Content="Zamknij" Style="{StaticResource Primary}" IsDefault="True" Click="Close_Click"/></StackPanel>
    </DockPanel>
  </Grid>
</Window>
