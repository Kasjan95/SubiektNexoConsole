<Window x:Class="SubiektNexoConnector.Deployment.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SubiektNexoConnector · Instalacja i serwis" Width="1280" Height="780" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CFD6E1"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#185ADB"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#185ADB"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,0,16"/><Setter Property="BorderBrush" Value="#BAC5D5"/><Setter Property="MinHeight" Value="36"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Padding" Value="9"/><Setter Property="Margin" Value="0,5,0,16"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,12"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
    <Border Background="#172D4D" CornerRadius="12" Padding="20" Margin="0,0,16,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="NEXO CONNECTOR" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,30"/>
        <TextBlock DockPanel.Dock="Bottom" Foreground="#C7D7ED" Text="Instalacja i serwis adaptera&#10;&#10;Dane klienta pozostają na jego komputerze i serwerze Nexo."/>
        <StackPanel><TextBlock x:Name="NavigationText" Foreground="White" FontSize="15" LineHeight="32"/><ProgressBar x:Name="BusyProgress" IsIndeterminate="True" Height="4" Margin="0,24,0,0" Visibility="Collapsed"/></StackPanel>
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="26" Margin="0,0,16,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock x:Name="TitleText" FontSize="26" FontWeight="SemiBold" Foreground="#172D4D"/><TextBlock x:Name="SubtitleText" Foreground="#53647B" Margin="0,8,0,0"/></StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid>
            <StackPanel x:Name="HomePanel">
              <TextBlock Text="Zarządzane i wykryte instalacje" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <Grid MinHeight="170" Margin="0,0,0,18"><ListBox x:Name="InstancesList" DisplayMemberPath="Display" SelectionChanged="InstancesList_SelectionChanged"/><TextBlock x:Name="EmptyInstancesText" Text="Nie znaleziono instalacji adaptera na tym komputerze." Foreground="#53647B" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid>
              <WrapPanel><Button Content="Nowa instalacja" Style="{StaticResource Primary}" Click="New_Click"/><Button x:Name="HomeRepairButton" Content="Napraw / aktualizuj" Click="Repair_Click" IsEnabled="False"/><Button x:Name="HomeRemoveButton" Content="Odinstaluj" Click="Remove_Click" IsEnabled="False"/></WrapPanel>
              <TextBlock Text="Wybierz instalację z listy, aby nią zarządzać. Pozycja „starsza — do przejęcia” oznacza konfigurację sprzed obecnego instalatora." Foreground="#53647B" Margin="0,12,0,0"/>
            </StackPanel>
            <StackPanel x:Name="MaintenancePanel" Visibility="Collapsed">
              <TextBlock x:Name="MaintenanceInstanceText" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/>
              <Button x:Name="MaintenanceCheckButton" Content="Sprawdź działanie" Click="Check_Click" HorizontalAlignment="Stretch"/><TextBlock Text="Health i autoryzowany test Sfery; bez zmian w instalacji." Foreground="#53647B" Margin="0,0,0,12"/>
              <Button x:Name="MaintenanceRepairButton" Content="Napraw / wznów przerwaną operację" Style="{StaticResource Primary}" Click="RepairSelected_Click" HorizontalAlignment="Stretch"/><TextBlock Text="Uzgadnia zasoby tej samej wersji." Foreground="#53647B" Margin="0,0,0,12"/>
              <Button x:Name="MaintenanceUpdateButton" Content="Aktualizuj do wersji z tego instalatora" Click="Update_Click" HorizontalAlignment="Stretch"/><TextBlock Text="Zachowuje instancję, podmiot, ustawienia i klucz API." Foreground="#53647B" Margin="0,0,0,12"/>
              <Button x:Name="MaintenanceImportButton" Content="Przejmij starszą instalację" Style="{StaticResource Primary}" Click="Import_Click" HorizontalAlignment="Stretch"/><TextBlock Text="Wymaga wskazania oryginalnego MPKG." Foreground="#53647B" Margin="0,0,0,12"/>
              <Expander Header="Odzyskiwanie zaawansowane" Margin="0,10,0,0"><StackPanel Margin="0,10,0,0"><Button x:Name="MaintenanceRestorePackageButton" Content="Przywróć MPKG z kopii" Click="RestorePackage_Click"/><Button x:Name="MaintenanceRestoreSettingsButton" Content="Odzyskaj settings.json z kopii" Click="RestoreSettings_Click"/></StackPanel></Expander>
            </StackPanel>
            <StackPanel x:Name="ConnectionPanel" Visibility="Collapsed">
              <Label Target="{Binding ElementName=InstanceBox}" Content="Nazwa instancji"/><TextBox x:Name="InstanceBox" Text="pilot-01"/>
              <Label Target="{Binding ElementName=ServerBox}" Content="Serwer SQL Nexo"/><TextBox x:Name="ServerBox" ToolTip="Np. SERWER\INSERTNEXO"/>
              <CheckBox x:Name="SqlWindowsCheck" IsChecked="False" Content="Uwierzytelnianie Windows do SQL" Checked="SqlWindowsCheck_Changed" Unchecked="SqlWindowsCheck_Changed"/>
              <StackPanel x:Name="SqlCredentialsPanel"><Label Target="{Binding ElementName=SqlUserBox}" Content="Login SQL"/><TextBox x:Name="SqlUserBox" Text="sa"/><Label Target="{Binding ElementName=SqlPasswordBox}" Content="Hasło SQL (może być puste)"/><PasswordBox x:Name="SqlPasswordBox"/></StackPanel>
              <TextBlock Text="Dane SQL służą tylko do tego połączenia i nie są zapisywane przez instalator." Foreground="#53647B" Margin="0,0,0,8"/>
              <Expander Header="Ścieżki zaawansowane" Margin="0,10,0,0"><StackPanel><TextBlock Text="Zainstalowany InsLauncher.exe"/><TextBox x:Name="LauncherBox"/><TextBlock x:Name="PublishLabel" Text="Katalog publish (tylko tryb developerski)"/><TextBox x:Name="PublishBox"/></StackPanel></Expander>
              <Label Target="{Binding ElementName=PortBox}" Content="Port HTTP"/><TextBox x:Name="PortBox" Text="15001"/>
              <Label Target="{Binding ElementName=NexoUserBox}" Content="Operator Nexo"/><TextBox x:Name="NexoUserBox"/><TextBlock Text="Hasło operatora Nexo (przy naprawie puste = zachowaj)"/><PasswordBox x:Name="NexoPasswordBox"/>
              <Button Content="Połącz i wybierz podmiot" Style="{StaticResource Primary}" Click="Connect_Click"/><Button x:Name="LocalRemoveButton" Content="Serwer niedostępny — usuń tylko lokalnie" Click="LocalRemove_Click" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
              <TextBlock x:Name="DatabaseText" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock Text="Konto uruchamiające Nexo i adapter"/><TextBlock x:Name="AccountText" Foreground="#53647B" Margin="0,6,0,10"/><Button Content="Wybierz konto — okno Windows" Click="Credentials_Click"/><TextBlock Text="Wybierz konto z zapamiętanym podmiotem w InsLauncherze. Pełny autostart wymaga hasła; PIN nie wystarczy." Foreground="#53647B"/>
              <TextBlock Text="Dozwolone IP/CIDR backendu (lub LocalSubnet)" Margin="0,18,0,0"/><TextBox x:Name="AddressesBox" Text="LocalSubnet"/><TextBlock Text="Sieci, w których adapter ma być dostępny"/>
              <WrapPanel><CheckBox x:Name="PrivateProfileCheck" Content="Prywatna" IsChecked="True" Margin="0,8,20,12"/><CheckBox x:Name="DomainProfileCheck" Content="Domenowa" IsChecked="True" Margin="0,8,20,12"/><CheckBox x:Name="PublicProfileCheck" Content="Publiczna"/></WrapPanel>
              <TextBlock Text="Integracje opcjonalne" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,4"/><CheckBox x:Name="SeqCheck" Content="Wysyłaj logi do Seq" IsChecked="False"/><TextBox x:Name="SeqBox" Text="http://localhost:5341" IsEnabled="{Binding IsChecked, ElementName=SeqCheck}"/><TextBlock Text="Bez Seq logi są nadal zapisywane lokalnie. Niedostępny Seq nie blokuje działania adaptera." Foreground="#53647B"/>
              <CheckBox x:Name="ShortcutCheck" Content="Utwórz skrót na wspólnym pulpicie" IsChecked="True"/><CheckBox x:Name="RebootCheck" Content="Po udanej instalacji zaproponuj test po restarcie"/><CheckBox x:Name="ReinstallCheck" Content="Naprawa: ponownie wgraj zachowany MPKG tej samej wersji"/><Button Content="Przejdź do podsumowania" Style="{StaticResource Primary}" Click="Summary_Click"/>
            </StackPanel>
            <StackPanel x:Name="SummaryPanel" Visibility="Collapsed"><TextBlock x:Name="SummaryText" LineHeight="25"/><CheckBox x:Name="RetryUpdateCheck" Visibility="Collapsed" Content="Po niepewnym wyniku Deploy: potwierdzam ponowne wgranie tego samego pakietu aktualizacji"/><Border Background="#EDF3FF" Padding="16" Margin="0,20,0,20"><TextBlock Text="Instalator zmieni konfigurację Windows i przypisanie pakietu Nexo. Podczas naprawy adapter może być chwilowo niedostępny. Klucz API zostanie zapisany w chronionym pliku TXT."/></Border><Button x:Name="ExecuteButton" Content="Zainstaluj / napraw" Style="{StaticResource Primary}" Click="Install_Click"/></StackPanel>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><TextBlock x:Name="ResultText" Margin="0,0,0,20" LineHeight="23"/><WrapPanel x:Name="ResultActions"><Button x:Name="RetryTestButton" Content="Ponów test API i autostartu" Click="RetryTest_Click"/><Button Content="Eksportuj klucz TXT" Click="ExportKey_Click"/><Button Content="Zapisz diagnostykę" Click="Diagnostics_Click"/><Button Content="Wróć do instancji" Click="Home_Click"/><Button x:Name="PurgeButton" Content="Usuń zachowane dane odinstalowanej instancji" Click="Purge_Click" Visibility="Collapsed"/></WrapPanel></StackPanel>
          </Grid>
        </ScrollViewer>
        <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="BackButton" Content="Wstecz" Click="Back_Click"/><Button x:Name="CancelButton" Content="Anuluj operację" Click="Cancel_Click" Visibility="Collapsed"/></DockPanel>
      </Grid>
    </Border>
    <Border Grid.Column="2" Background="#172D4D" CornerRadius="12" Padding="18">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10"><TextBlock Text="PRZEBIEG" Foreground="White" FontWeight="Bold" FontSize="16"/><TextBlock Text="Bieżący etap i komunikaty" Foreground="#C7D7ED" Margin="0,4,0,0"/></StackPanel>
        <TextBox x:Name="ActivityText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="#10233D" Foreground="#EAF2FF" BorderThickness="0" Padding="10" Margin="0,0,0,14" FontFamily="Consolas" FontSize="12"/>
        <TextBlock Grid.Row="2" Text="ETAPY INSTALACJI" Foreground="White" FontWeight="Bold" Margin="0,0,0,8"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="StepsText" Foreground="#EAF2FF" LineHeight="23"/></ScrollViewer>
        <Border Grid.Row="4" Background="#5A321A" Padding="10" Margin="0,12,0,0" x:Name="ErrorPanel" Visibility="Collapsed" MaxHeight="150"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ErrorText" Foreground="#FFE4C2" AutomationProperties.LiveSetting="Assertive"/></ScrollViewer></Border>
      </Grid>
    </Border>
  </Grid>
</Window>
